{
  "name": "phyllum",
  "version": "0.7.3",
  "description": "Design system companion — turns prose, images, or your codebase into tokens and components, recorded in DESIGN-SYSTEM.md",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndisisnd/phyllum.git"
  },
  "homepage": "https://github.com/ndisisnd/phyllum#readme",
  "bugs": {
    "url": "https://github.com/ndisisnd/phyllum/issues"
  },
  "bin": {
    "phyllum": "bin/phyllum.js"
  },
  "main": "lib/execute.js",
  "exports": {
    ".": "./lib/execute.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "skill/",
    "server/",
    "gui/",
    "templates/"
  ],
  "scripts": {
    "test": "node --test --import=./evals/harness/fs-harness.js \"evals/assertions/**/*.test.js\"",
    "test:bare": "node --test \"evals/assertions/**/*.test.js\"",
    "evals": "node evals/run-evals.js",
    "evals:record": "node evals/run-evals.js --record",
    "evals:record-model": "node evals/record-model.js",
    "check": "npm test && npm run evals",
    "release:patch": "node evals/release.js patch",
    "release:minor": "node evals/release.js minor"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "claude-code",
    "skill",
    "cli"
  ],
  "dependencies": {},
  "devDependencies": {}
}
