{
  "eval": "create-pick-candidates",
  "rubric": "evals/rubrics/create-pick-candidates.md",
  "milestone": "v0.1.0 M5",
  "planSections": ["§3.1", "§8.5"],
  "threshold": 1,
  "status": "runnable — `npm run evals`",
  "cases": [
    {
      "id": "repeated-chip-is-a-candidate",
      "fixture": "evals/fixtures/codebases/repeated-jsx",
      "designSystem": "evals/fixtures/design-system/populated.md",
      "expect": "present",
      "signature": "span.chip.chip--info",
      "name": "Badge/Info",
      "archetype": "badge",
      "minCount": 3,
      "note": "The plan's own case: a repeated unregistered JSX pattern turns up in the candidate list."
    },
    {
      "id": "repeated-card-is-a-candidate",
      "fixture": "evals/fixtures/codebases/repeated-jsx",
      "designSystem": "evals/fixtures/design-system/populated.md",
      "expect": "present",
      "signature": "div.card.card--flat",
      "name": "Card/Default",
      "archetype": "card",
      "minCount": 3
    },
    {
      "id": "already-registered-drops-out",
      "fixture": "evals/fixtures/codebases/repeated-jsx",
      "designSystem": "evals/fixtures/design-system/populated.md",
      "expect": "absent",
      "signature": "button.button-primary",
      "note": "`button-primary` is what Phyllum calls Button/Primary, which the system already has — it is a component, not a candidate."
    },
    {
      "id": "one-sighting-is-not-a-pattern",
      "fixture": "evals/fixtures/codebases/repeated-jsx",
      "designSystem": "evals/fixtures/design-system/populated.md",
      "expect": "absent",
      "signature": "button.btn.btn--ghost",
      "note": "Used once. The minimum in the signals table is two."
    },
    {
      "id": "a-codebase-with-nothing-repeated-proposes-nothing",
      "fixture": "evals/fixtures/codebases/react-css",
      "designSystem": "evals/fixtures/design-system/empty.md",
      "expect": "absent",
      "signature": "button.btn.btn--primary",
      "note": "One button in one file is not a pattern, and a picker that invents candidates is worse than one that offers none."
    },
    {
      "id": "primitives-asks-per-token-before-proposing",
      "kind": "primitives",
      "planSections": ["§5.1", "§5.3"],
      "colours": [
        ["accentRed", "#DC2626"],
        ["brand-blue", "#2563EB"]
      ],
      "answers": { "accentRed": true, "brand-blue": false, "neutral": true },
      "expect": { "asked": ["accentRed", "brand-blue", "neutral"], "proposed": ["accentRed", "neutral"] },
      "note": "Each token gets its own yes/no before any ramp is proposed for it, in the order the file lists them — and a no generates nothing for that token."
    },
    {
      "id": "primitives-with-no-colour-tokens-offers-the-neutral-ramp-only",
      "kind": "primitives",
      "planSections": ["§5.1"],
      "colours": [],
      "answers": { "neutral": true },
      "expect": { "asked": ["neutral"], "proposed": ["neutral"] },
      "note": "With nothing recorded there is nothing to derive from, so the shipped neutral ramp is the whole offer."
    },
    {
      "id": "primitives-never-asks-about-a-value-it-cannot-read",
      "kind": "primitives",
      "planSections": ["§5.2"],
      "colours": [["brandVar", "var(--brand)"]],
      "answers": { "neutral": false },
      "expect": { "asked": ["neutral"], "proposed": [] },
      "note": "A ramp is derived from a colour. A value that is not one is reported as skipped, never guessed at — and never offered as though it could be."
    },
    {
      "id": "primitives-does-not-re-ask-about-a-ramp-that-is-already-there",
      "kind": "primitives",
      "planSections": ["§5.3"],
      "colours": [["accentRed", "#DC2626"]],
      "existingRamps": ["accentRed"],
      "answers": { "neutral": false },
      "expect": { "asked": ["neutral"], "proposed": [] },
      "note": "Rerunnable: a ramp whose steps are all present is reported, not offered a second time."
    }
  ]
}
